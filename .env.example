# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"


# QueueTurn production backend
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Paddle Billing (Sandbox first; never commit real secrets)
# Required explicitly; the application fails closed if this is unset or not sandbox.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=pdl_sdbx_replace_me
PADDLE_WEBHOOK_SECRET=replace_with_paddle_notification_destination_secret
# Public Sandbox client-side token only (safe for browser use; must start with test_).
VITE_PADDLE_CLIENT_TOKEN=test_replace_with_sandbox_client_side_token
PADDLE_PRICE_STARTER_MONTHLY=pri_01m4j58xsfkp7bh4n9sdr53vja
PADDLE_PRICE_STARTER_ANNUAL=pri_01m4j58y3k8pvbbmjwk9kh11ee
PADDLE_PRICE_PRO_MONTHLY=pri_01m4j58yp31gc7cgcsw55y2rd8
PADDLE_PRICE_PRO_ANNUAL=pri_01m4j58yyhasjnr15bkan1dzpg
PADDLE_PRICE_UNLIMITED_MONTHLY=pri_01m4j58zg5krvmwztbgmwys81w
PADDLE_PRICE_UNLIMITED_ANNUAL=pri_01m4j58zsegkt8d3p7aewkv4n2
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
APP_BASE_URL=https://www.queueturn.com

# Paddle dashboard setup: Checkout > Checkout configuration > Default payment link.
# Set the Sandbox default link to your sandbox checkout page; localhost is allowed for Sandbox testing.
# Before Live, the link must use a real approved domain.
